# VISION Environment — copy to .env and configure
# Ollama must be running locally. No external API required.

OLLAMA_BASE_URL=http://localhost:11434
# Text model — must be installed: ollama pull llama3
OLLAMA_TEXT_MODEL=llama3
# Vision model — must support image input. Examples: llava, moondream, bakllava, llava-phi3
# Leave empty to disable vision: OLLAMA_VISION_MODEL=
OLLAMA_VISION_MODEL=moondream
OLLAMA_TEXT_TIMEOUT=30000
OLLAMA_VISION_TIMEOUT=120000
OLLAMA_VISION_ENABLED=True

OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768

# Attachments
VISION_MAX_IMAGES_PER_MESSAGE=5
VISION_MAX_IMAGE_SIZE_MB=10
VISION_MAX_IMAGE_DIMENSION=2048

# Admin panel (env-driven, never hard-code in frontend)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# For production, set ADMIN_PASSWORD_HASH instead (generated via Django make_password or knowledge.auth.make_hash_for_env)
# ADMIN_PASSWORD_HASH=pbkdf2_sha256$...
ADMIN_JWT_SECRET=change-me-use-strong-secret
ADMIN_JWT_EXPIRY_HOURS=12

# Knowledge engine
KNOWLEDGE_MAX_PAGES_PER_SOURCE=50
KNOWLEDGE_MAX_DEPTH=2
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_RETRIEVAL_TOP_K=5
KNOWLEDGE_MIN_SIMILARITY=0.55

# For local dev without Postgres
# USE_SQLITE=1
# DATABASE_URL=sqlite:////tmp/db.sqlite3
